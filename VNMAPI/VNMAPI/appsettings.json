{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    //"DefaultConnection": "Server=LAPTOP-GEFM2G6U\\SQLEXPRESS; Database=EmployeeDB; Trusted_Connection=True; MultipleActiveResultSets=true; TrustServerCertificate=True;"
    "DefaultConnection": ""
  },

  "Jwt": {
    //"SecretKey": "",
    "SecretKey": "",
    "Issuer": "https://localhost:7079/",
    "Audience": "https://localhost:7079/",
    "TokenValidityInMinutes": 1,
    "RefreshTokenValidityInDays": 7
  },

  "EmailSetting": {
    "Host": "",
    "Port": "",
    "FromMail": "",
    "Password": "",
    "IsEnableSSL": "0", //1- true, 0- false
    "IsUseDefaultCredentials": "1" //1- true. 0- false
  },

  "IpRateLimiting": {
    "EnableEndpointRateLimiting": true,
    "StackBlockedRequests": false, // if false - pure rate limitting (immediate reject or block the requests after limit over with given period) and 
    //true - behave like Throtlling (delay or queued requests after limit over with given period)
    "RealIpHeader": "X-Real-IP",
    "ClientIdHeader": "X-ClientId",
    "HttpStatusCode": 429,
    "GeneralRules": [
      {
        "Endpoint": "*",
        "Period": "1m",
        "Limit": 2
      }
    ]
  },

  "APIExpirySetting": {
    "Version": 1,
    "ExpiryDay": 5
  }



}
